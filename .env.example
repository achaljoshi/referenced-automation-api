# Copy to .env.<yourenv>.local for secrets that must never be committed
# (real API keys/tokens). This repo's own test suite (tests/apiClient.spec.ts)
# talks to an in-process mock server and does NOT read these - they're the
# template every real consuming project follows for its own API_BASE_URL.

LOG_LEVEL=info
API_BASE_URL=https://api.qa.example.com
API_KEY=replace-me

# ---- Calling the API from the remote desktop host (README: "Calling the API from the remote desktop") ----
# NOT VERIFIED on a real RDP host. The REMOTE_* keys (REMOTE_ENABLED, REMOTE_RDP_HOST, REMOTE_RDP_USER, REMOTE_RDP_PASSWORD, ...)
# are documented in .env.example of @automation/referenced-automation-utils and its docs/REMOTE_DESKTOP.md; set them first.
# REMOTE_API_BASE_URL=https://api.internal.example   # the API's URL AS SEEN FROM THE REMOTE HOST (falls back to API_BASE_URL)
# API_VIA_REMOTE=false                               # true: apiClient / apiFor (and so BDD features) call from the remote host
