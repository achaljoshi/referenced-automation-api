# =============================================================================
# Configuration reference - EVERY environment variable referenced-automation-api reads, directly or through the shared
# createPlaywrightConfig / loadEnv code of @automation/referenced-automation-utils.
# This file is documentation: nothing loads it. Copy the lines you need into
#
#   .env.<name>          committed, NO secrets      (.env.qa, .env.stage, .env.dev)
#   .env.<name>.local    git-ignored, secrets only  (template: .env.local.example)
#
# and pick the file with the ENV variable (default qa). Load order, later wins:
#   .env -> .env.<ENV> -> .env.<ENV>.local -> the real environment (shell / CI variables).
# The secret file is named after the environment: ENV=qa reads .env.qa.local, NOT .env.local.
#
# Every variable below is documented the same way, on the lines above it:
#   what it is for / Read from / Values / Default | Required | Secret / Example
# "Read from" matters: a variable marked "real environment only" is read straight from
# process.env, so a line for it in a .env file has NO effect - set it in the shell or in CI:
#   bash / zsh : LOG_LEVEL=debug npx playwright test
#   PowerShell : $env:LOG_LEVEL = "debug"; npx playwright test      (undo: Remove-Item Env:LOG_LEVEL)
#   cmd.exe    : set LOG_LEVEL=debug && npx playwright test
#
# TIP - quoting values (dotenv rules):
#   * A value that contains # (starts a comment: PASSWORD=pa#ss is read as "pa"), $, quotes, or leading/trailing
#     spaces must be wrapped in double quotes:  REMOTE_RDP_PASSWORD="pa#ss $word 'x'"
#   * Inside double quotes \n becomes a line break, so a Windows value with backslashes (DOMAIN\new-user,
#     C:\new\dir) is safer unquoted or in single quotes:  REMOTE_RDP_USER='DOMAIN\new-user'
#   * A value that itself contains a double quote goes in single quotes:  NOTE='say "hi"'
#   * A key with an empty value (KEY=) is set to the empty string, which is not the same as not set.
#
# Secrets (Secret: YES) belong in .env.<name>.local or the CI secret store - never in a committed file:
#   cp .env.local.example .env.qa.local          (PowerShell: Copy-Item .env.local.example .env.qa.local)
#
# Shared keys (Playwright run settings, logging, ENV, the REMOTE_* keys) are implemented in referenced-automation-utils and
# documented there in full: https://github.com/achaljoshi/referenced-automation-utils/blob/master/.env.example
# Repo-specific keys of this API suite: API_BASE_URL, API_VIA_REMOTE, REMOTE_API_BASE_URL, the API_USER / API_PASSWORD /
# API_TOKEN / API_KEY / API_COOKIE credentials of the curl converter, the sample-feature keys and the script / pipeline keys.
#
# Variable lines below are commented out; remove the leading "# " to use one.
# Tests that check this file: tests/envDocs.spec.ts (every variable the code reads is here, and nothing else).
# =============================================================================


# ---- Environment selection ---------------------------------------------------------------------------------------

# Which environment to run against = which .env.<name> files are loaded and what is shown as "env" in the report.
# Read from: the real environment only (it chooses the file, so a line ENV=... inside a file is ignored)
# Values: any name that has a .env.<name> file here: qa | stage | dev | your own   (a name with no file just loads no file)
# Default: qa | Required: no | Secret: no
# Example: ENV=stage
# ENV=qa

# Fallback name for ENV, for machines where another tool already owns ENV. ENV wins when both are set.
# Read from: the real environment only
# Values: same as ENV
# Default: unset (then qa) | Required: no | Secret: no
# Example: ENVIRONMENT=stage
# ENVIRONMENT=qa


# ---- Target API (shared key, set per repo) -------------------------------------------------------------------------
# This suite's playwright.config.ts passes baseUrlKey: 'API_BASE_URL' to createPlaywrightConfig, so the API is read from
# API_BASE_URL (BASE_URL, the key UI suites use, is NOT read here).

# Base URL of the API under test. createPlaywrightConfig makes it Playwright's baseURL (use.baseURL), which the apiClient
# fixture and the Gherkin steps use; the curl converter moves the host of your curl commands here. A base URL with a path
# (https://gw.example.com/api/v1) keeps that path in front of every request path.
# Read from: .env files or the real environment (the apiClient fixture reads the .env.<ENV> files next to playwright.config.ts)
# Values: an absolute URL with scheme, e.g. https://api.qa.example.com
# Default: unset | Required: no for the config itself; yes for any test that calls a relative path | Secret: no
# Example: API_BASE_URL=https://api.qa.example.com
# API_BASE_URL=https://api.qa.example.com


# ---- Run selection (shared: createPlaywrightConfig) ----------------------------------------------------------------
# An API suite needs no browser for its apiClient tests: BROWSER, DEVICE, VIEWPORT_*, LOCALE, TIMEZONE_ID and COLOR_SCHEME
# only matter for tests that use a `page` (mockApiRoute, record / replay). IGNORE_HTTPS_ERRORS applies to apiClient too.

# Which browser(s) to run. An unknown value fails at start-up with the list of valid names.
# Read from: .env files or the real environment
# Values: chromium | firefox | webkit | msedge | msedge-beta | msedge-dev | chrome | chrome-beta | chrome-dev | all (the three engines) | all-devices (the mobile devices)
# Default: chromium | Required: no | Secret: no
# Example: BROWSER=firefox
# BROWSER=chromium

# Emulate one Playwright device instead of a desktop browser; wins over BROWSER. An unknown name fails at start-up.
# Read from: .env files or the real environment
# Values: any name in Playwright's device list, e.g. "iPhone 15", "Pixel 7", "iPad Pro 11" (quote names with spaces)
# Default: unset (then BROWSER decides) | Required: no | Secret: no
# Example: DEVICE="iPhone 15"
# DEVICE=

# Run the browser without a window.
# Read from: .env files or the real environment
# Values: true | false (also 1/0, yes/no, on/off; anything else, such as "ture", is an error)
# Default: true | Required: no | Secret: no
# Example: HEADLESS=false
# HEADLESS=true

# How many test files run at the same time. With API_VIA_REMOTE=true the remote agent handles one request at a time, so use few workers.
# Read from: .env files or the real environment
# Values: a whole number >= 1, or a percentage of the logical cores such as 50%
# Default: unset (Playwright uses half of the logical cores) | Required: no | Secret: no
# Example: WORKERS=4
# WORKERS=

# How often a failed test is run again before it counts as failed (a test that passes on a retry is reported as flaky).
# Read from: .env files or the real environment
# Values: a whole number >= 0
# Default: 0 on a developer machine; 1 when the CI variable is set | Required: no | Secret: no
# Example: RETRIES=2
# RETRIES=0

# Stop the whole run after this many failed tests.
# Read from: .env files or the real environment
# Values: a whole number >= 0 (0 = never stop early)
# Default: 0 | Required: no | Secret: no
# Example: MAX_FAILURES=5
# MAX_FAILURES=0

# Slow every browser action down so a person can watch (debugging only; browser tests, not apiClient calls).
# Read from: .env files or the real environment
# Values: milliseconds, a whole number >= 0 (0 = off)
# Default: 0 | Required: no | Secret: no
# Example: SLOW_MO_MS=250
# SLOW_MO_MS=0

# Width of the browser window for desktop projects.
# Read from: .env files or the real environment
# Values: pixels, a whole number
# Default: 1280 | Required: no | Secret: no
# Example: VIEWPORT_WIDTH=1920
# VIEWPORT_WIDTH=1280

# Height of the browser window for desktop projects.
# Read from: .env files or the real environment
# Values: pixels, a whole number
# Default: 800 | Required: no | Secret: no
# Example: VIEWPORT_HEIGHT=1080
# VIEWPORT_HEIGHT=800

# Browser language (navigator.language, Accept-Language, date and number formats).
# Read from: .env files or the real environment
# Values: a BCP 47 tag such as en-GB, de-DE, fr-CA
# Default: unset (the browser's own) | Required: no | Secret: no
# Example: LOCALE=en-GB
# LOCALE=

# Browser time zone, so date assertions do not depend on where the test machine is.
# Read from: .env files or the real environment
# Values: an IANA zone name such as Europe/London, America/New_York, UTC
# Default: unset (the machine's own) | Required: no | Secret: no
# Example: TIMEZONE_ID=Europe/London
# TIMEZONE_ID=

# Emulated prefers-color-scheme.
# Read from: .env files or the real environment
# Values: light | dark | no-preference
# Default: unset (the browser's own) | Required: no | Secret: no
# Example: COLOR_SCHEME=dark
# COLOR_SCHEME=

# Accept invalid or self-signed HTTPS certificates (test environments only). Applies to the browser and to apiClient / apiFor.
# Read from: .env files or the real environment
# Values: true | false (also 1/0, yes/no, on/off)
# Default: false | Required: no | Secret: no
# Example: IGNORE_HTTPS_ERRORS=true
# IGNORE_HTTPS_ERRORS=false

# The attribute getByTestId() looks at.
# Read from: .env files or the real environment
# Values: an HTML attribute name, e.g. data-testid, data-test, data-qa
# Default: data-testid | Required: no | Secret: no
# Example: TEST_ID_ATTRIBUTE=data-test
# TEST_ID_ATTRIBUTE=data-testid


# ---- Timeouts, all in milliseconds (shared: createPlaywrightConfig) -------------------------------------------------

# How long one whole test may take.
# Read from: .env files or the real environment
# Values: milliseconds, a whole number
# Default: 30000 | Required: no | Secret: no
# Example: TEST_TIMEOUT_MS=60000
# TEST_TIMEOUT_MS=30000

# How long a web-first assertion (expect(...)) waits for its condition.
# Read from: .env files or the real environment
# Values: milliseconds, a whole number
# Default: 10000 | Required: no | Secret: no
# Example: EXPECT_TIMEOUT_MS=15000
# EXPECT_TIMEOUT_MS=10000

# Playwright's default timeout for one action (a browser click or fill); a single API call can set its own timeoutMs.
# Read from: .env files or the real environment
# Values: milliseconds, a whole number
# Default: 15000 | Required: no | Secret: no
# Example: ACTION_TIMEOUT_MS=20000
# ACTION_TIMEOUT_MS=15000

# How long a browser navigation (page.goto, link clicks) waits.
# Read from: .env files or the real environment
# Values: milliseconds, a whole number
# Default: 30000 | Required: no | Secret: no
# Example: NAVIGATION_TIMEOUT_MS=60000
# NAVIGATION_TIMEOUT_MS=30000

# How long the whole run may take before Playwright stops it.
# Read from: .env files or the real environment
# Values: milliseconds, a whole number (0 = no limit)
# Default: 0 | Required: no | Secret: no
# Example: GLOBAL_TIMEOUT_MS=3600000
# GLOBAL_TIMEOUT_MS=0


# ---- Logging (shared: logger/logger.ts) ---------------------------------------------------------------------------
# All six keys are read straight from process.env, so they work in the shell or in CI variables and NOT in a .env file.

# Minimum level written to the console and the log file.
# Read from: the real environment only (the logger reads process.env once, when it is first imported; .env files are not read)
# Values: error | warn | info | http | verbose | debug | silly
# Default: info | Required: no | Secret: no
# Example: LOG_LEVEL=debug
# LOG_LEVEL=info

# Also write the JSON-lines log file (a CI artifact). If the file cannot be created the logger carries on with the console only.
# Read from: the real environment only
# Values: true | false (only the text "false", any case, turns it off)
# Default: true | Required: no | Secret: no
# Example: LOG_TO_FILE=false
# LOG_TO_FILE=true

# Where the log file is written.
# Read from: the real environment only
# Values: a path, relative to the folder tests start in or absolute
# Default: logs/automation.log | Required: no | Secret: no
# Example: LOG_FILE=logs/run-42.log
# LOG_FILE=logs/automation.log

# One log file per Playwright worker (logs/automation-w2.log) instead of every worker appending to one file.
# Read from: the real environment only
# Values: true | false (only the text "true", any case, turns it on)
# Default: false | Required: no | Secret: no
# Example: LOG_FILE_PER_WORKER=true
# LOG_FILE_PER_WORKER=false

# Switch coloured console output off. Colour is already off when CI is set or the output is not a terminal.
# Read from: the real environment only
# Values: any non-empty value turns colour off (the NO_COLOR convention)
# Default: unset | Required: no | Secret: no
# Example: NO_COLOR=1
# NO_COLOR=

# Switch coloured console output on even in CI or when the output is piped.
# Read from: the real environment only
# Values: any non-empty value turns colour on (even 0 or false - it is the presence that counts)
# Default: unset | Required: no | Secret: no
# Example: FORCE_COLOR=1
# FORCE_COLOR=


# ---- Test data (shared) ---------------------------------------------------------------------------------------------

# Seeds the random-data generators (the {{random:...}} placeholders in Gherkin steps, randomUtils) for every Playwright
# worker, so a failing run can be replayed with the same data. The seed in use is logged at start-up.
# Read from: the real environment only
# Values: an integer
# Default: unset (a different random seed every run) | Required: no | Secret: no
# Example: RANDOM_SEED=12345
# RANDOM_SEED=


# ---- Credentials of the curl converter and the generated tests (npm run curl-to-tests) --------------------------------
# Values the converter recognises as secrets are NOT written into a generated test; the test reads them from the
# environment with env.get('<NAME>') and the command prints which names to set. The names are fixed for the common
# cases below (API_USER, API_PASSWORD, API_TOKEN, API_KEY) and DERIVED for every other secret:
#   * a header, query parameter, form field, JSON key or XML element/attribute NAMED like a secret becomes API_<NAME>:
#     the name in upper snake case with a leading API_ unless it already starts with API_ -
#     Cookie -> API_COOKIE, access_token -> API_ACCESS_TOKEN, client_secret -> API_CLIENT_SECRET,
#     X-Session-Token -> API_X_SESSION_TOKEN, pwd -> API_PWD, user_otp -> API_USER_OTP
#   * --param '<name-regex>=<ENV_VAR>' picks the variable name yourself
#   * $VAR / ${VAR} inside a curl command is read from the environment under exactly that name
#   * {{env:NAME}} placeholders in Gherkin features read NAME, and the step `I read the environment variable "NAME"` too
# Every derived secret is "Secret: YES" like the fixed ones: put it in .env.<ENV>.local. API_COOKIE is listed below as the
# one every browser "Copy as cURL" produces; the others follow the same rule. The generated test reads them through
# loadEnv() (the .env.<ENV> and .env.<ENV>.local files of the Playwright project, then the real environment).

# Login name for HTTP Basic auth (curl -u user:pass, or an Authorization: Basic header, which is decoded into BasicAuth).
# Read from: .env files or the real environment, by the generated test
# Values: any text
# Default: unset | Required: yes for a generated test that uses Basic auth | Secret: no
# Example: API_USER=qa-user
# API_USER=

# Password for HTTP Basic auth, and the value of any form field / JSON key named password / passwd / pwd.
# Read from: .env files or the real environment, by the generated test
# Values: any text (wrap a value containing # $ or quotes in double quotes)
# Default: unset | Required: yes for a generated test that uses Basic auth or sends a password | Secret: YES - .env.<name>.local or a CI secret, never a committed file
# Example (in .env.qa.local): API_PASSWORD="replace-me"
# API_PASSWORD=

# Bearer token (curl -H 'Authorization: Bearer ...'), sent by BearerAuth.
# Read from: .env files or the real environment, by the generated test
# Values: the token text
# Default: unset | Required: yes for a generated test that uses a Bearer token | Secret: YES - .env.<name>.local or a CI secret, never a committed file
# Example (in .env.qa.local): API_TOKEN="replace-me"
# API_TOKEN=

# API key (curl -H 'X-API-Key: ...'), sent by ApiKeyAuth under the header name the command used.
# Read from: .env files or the real environment, by the generated test
# Values: the key text
# Default: unset | Required: yes for a generated test that uses an API key | Secret: YES - .env.<name>.local or a CI secret, never a committed file
# Example (in .env.qa.local): API_KEY="replace-me"
# API_KEY=

# Cookie header (curl -b ... or -H 'Cookie: ...'): a derived name, the converter's rule applied to the header Cookie.
# Read from: .env files or the real environment, by the generated test
# Values: the whole cookie header value, e.g. sid=abc; theme=dark (quote it: it contains ; and spaces)
# Default: unset | Required: yes for a generated test that sends a cookie | Secret: YES - .env.<name>.local or a CI secret, never a committed file
# Example (in .env.qa.local): API_COOKIE="sid=replace-me"
# API_COOKIE=


# ---- Calling the API from the remote desktop host (README: "Calling the API from the remote desktop") ---------------
# NOT VERIFIED on a real RDP host. With REMOTE_ENABLED=true the apiClient can send each call through a Windows host that is
# reachable only by Remote Desktop (for example from an AWS WorkSpace). With REMOTE_ENABLED unset or false every other
# REMOTE_* key is ignored. Put REMOTE_RDP_PASSWORD and REMOTE_DB_CONNECTION_STRING in .env.<name>.local, never in a
# committed file. The REMOTE_* keys are read by utils (remote.remoteConfigFromEnv): the seven most used are listed below;
# all other REMOTE_* keys (REMOTE_ALLOW, REMOTE_AGENT_START, REMOTE_SHARE_DIR, the timeouts ...): see
# https://github.com/achaljoshi/referenced-automation-utils/blob/master/.env.example and utils docs/REMOTE_DESKTOP.md.

# Make the apiClient and apiFor fixtures (so Gherkin features and generated tests too) call from the remote host, with no code change.
# Read from: .env files or the real environment (the fixtures read the .env.<ENV> files next to playwright.config.ts)
# Values: true | false (also 1/0, yes/no, on/off)
# Default: false | Required: no (needs REMOTE_ENABLED=true) | Secret: no
# Example: API_VIA_REMOTE=true
# API_VIA_REMOTE=false

# The API's base URL AS SEEN FROM THE REMOTE HOST (it may differ from the one the test machine uses); used by the remoteApiClient fixture.
# Read from: .env files or the real environment
# Values: an absolute URL with scheme
# Default: unset (then API_BASE_URL) | Required: no | Secret: no
# Example: REMOTE_API_BASE_URL=https://api.internal.example
# REMOTE_API_BASE_URL=

# Master switch for the remote host.
# Read from: .env files or the real environment
# Values: true | false (also 1/0, yes/no, on/off)
# Default: false | Required: no | Secret: no
# Example: REMOTE_ENABLED=true
# REMOTE_ENABLED=false

# Host name or address of the RDP host (no scheme, path or spaces).
# Read from: .env files or the real environment
# Values: a host name or IP address
# Default: unset | Required: yes when REMOTE_ENABLED=true | Secret: no
# Example: REMOTE_RDP_HOST=rdp-host.example.internal
# REMOTE_RDP_HOST=

# RDP port of the host.
# Read from: .env files or the real environment
# Values: a whole number from 1 to 65535
# Default: 3389 | Required: no | Secret: no
# Example: REMOTE_RDP_PORT=3389
# REMOTE_RDP_PORT=3389

# Login for the RDP host. May carry the domain as DOMAIN\user (do not double-quote a value with backslashes, see the TIP above).
# Read from: .env files or the real environment
# Values: a user name, or DOMAIN\user
# Default: unset | Required: yes with REMOTE_AGENT_START=alternate-shell (this machine logs in for you); no for startup / manual | Secret: no
# Example: REMOTE_RDP_USER='EXAMPLE\svc-tests'
# REMOTE_RDP_USER=

# Password for REMOTE_RDP_USER. Handed to mstsc through cmdkey only while it connects.
# Read from: .env files or the real environment
# Values: any text (wrap a value containing # $ or quotes in double quotes)
# Default: unset | Required: yes with REMOTE_AGENT_START=alternate-shell | Secret: YES - .env.<name>.local or a CI secret, never a committed file
# Example (in .env.qa.local): REMOTE_RDP_PASSWORD="replace-me"
# REMOTE_RDP_PASSWORD=

# The .NET DbProviderFactories invariant name used for database steps on the host (an API suite does not need it unless your own code runs DB steps there).
# Read from: .env files or the real environment
# Values: System.Data.SqlClient | System.Data.Odbc | System.Data.OleDb | another installed provider
# Default: unset | Required: yes for database steps on the host | Secret: no
# Example: REMOTE_DB_PROVIDER=System.Data.SqlClient
# REMOTE_DB_PROVIDER=

# The database connection string AS THE HOST uses it.
# Read from: .env files or the real environment
# Values: a provider-specific connection string (wrap it in double quotes: it contains ; = and often $ or #)
# Default: unset | Required: yes for database steps on the host | Secret: YES - .env.<name>.local or a CI secret, never a committed file
# Example (in .env.qa.local): REMOTE_DB_CONNECTION_STRING="Server=db.internal;Database=orders;User Id=svc;Password=replace-me;"
# REMOTE_DB_CONNECTION_STRING=


# ---- Sample features of this repo (features/*.feature) -----------------------------------------------------------------
# Only the Gherkin examples shipped here read these, through {{env:NAME|fallback}} placeholders: they show how a feature
# takes a value from the environment instead of writing it in the file. Your own features use your own names.

# The bearer token the sample feature features/authentication.feature sends (the in-process test server accepts the fallback).
# Read from: the real environment, then the .env.<ENV> files of the working directory (the {{env:...}} placeholder), so run from the repo root
# Values: any text
# Default: expected-token (the fallback written in the feature) | Required: no | Secret: no - the sample value is made up; a real token belongs in .env.<name>.local
# Example: FEATURE_SAMPLE_TOKEN=expected-token
# FEATURE_SAMPLE_TOKEN=

# The region the sample feature features/scenario-data.feature reads to show the {{env:NAME|fallback}} placeholder.
# Read from: the real environment, then the .env.<ENV> files of the working directory (the {{env:...}} placeholder)
# Values: any text
# Default: eu-west (the fallback written in the feature) | Required: no | Secret: no
# Example: FEATURE_SAMPLE_REGION=us-east
# FEATURE_SAMPLE_REGION=


# ---- Set by the machine, not by you ----------------------------------------------------------------------------------

# CI systems set this (GitLab: CI=true). It raises the retries default, forbids test.only, keeps all test output and turns console colour off.
# Read from: the real environment only
# Values: any non-empty value means "running in CI"
# Default: unset | Required: no (do not set it by hand unless you want the CI behaviour locally) | Secret: no
# Example: CI=1
# CI=

# Playwright sets this for every worker (0, 1, 2, ...); the logger prints it as [w2] and uses it for LOG_FILE_PER_WORKER. Do not set it yourself.
# Read from: the real environment only
# Values: a whole number, set by Playwright
# Default: unset outside a Playwright worker | Required: no | Secret: no
# Example: TEST_WORKER_INDEX=2
# TEST_WORKER_INDEX=

# The time zone of the Node process (dates, logs). Node itself reads it, and only from the real environment - a line in a .env file is NOT applied.
# Read from: the real environment only
# Values: an IANA zone name such as UTC or Europe/London
# Default: the machine's own time zone | Required: no | Secret: no
# Example: TZ=UTC
# TZ=UTC


# ---- Setup scripts and the CI pipeline (scripts/*.sh|.bat, .gitlab-ci.yml) -----------------------------------------------
# These run before any .env file could be read, so they are real-environment variables (shell, or GitLab CI/CD variables).
#   bash / zsh : export NPM_REGISTRY_URL="https://artifactory.example.com/artifactory/api/npm/npm-virtual/"
#   PowerShell : $env:NPM_REGISTRY_URL = "https://artifactory.example.com/artifactory/api/npm/npm-virtual/"
#   cmd.exe    : set NPM_REGISTRY_URL=https://artifactory.example.com/artifactory/api/npm/npm-virtual/

# The npm registry that scripts/setup, create-package and publish-package install from. They run `npm config set registry` with it; the pipeline does the same.
# Read from: the real environment only (the scripts run before any .env file could be read)
# Values: the registry URL of your organisation, e.g. an Artifactory npm repository
# Default: unset (npm keeps the registry it already uses; publish-package refuses to run without it) | Required: no for setup, yes for publish-package and for the pipeline | Secret: no
# Example: NPM_REGISTRY_URL=https://artifactory.example.com/artifactory/api/npm/npm-virtual/
# NPM_REGISTRY_URL=

# Same as passing --local to scripts/setup: build the sibling repos (referenced-automation-utils) and install their .tgz files instead of the registry versions.
# Read from: the real environment only
# Values: 1 turns it on; anything else (or unset) leaves it off
# Default: unset | Required: no | Secret: no
# Example: USE_LOCAL_PACKAGES=1
# USE_LOCAL_PACKAGES=

# Set BY scripts/create-package --local for its own npm commands so no browser binaries are downloaded; Playwright's installer reads it. You can set it yourself to skip the download in any install.
# Read from: the real environment only (read by Playwright's installer, not by this repo's code)
# Values: 1 skips the browser download
# Default: unset (set to 1 by create-package --local) | Required: no | Secret: no
# Example: PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
# PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=

# CI/CD variable of the pipeline: a mirror of Playwright's browser download host, for networks that cannot reach the real one.
# Read from: the real environment only (a GitLab CI/CD variable; read by Playwright's installer in the test job)
# Values: a URL of a mirror of the Playwright CDN
# Default: unset (Playwright uses its own CDN) | Required: no | Secret: no
# Example: PLAYWRIGHT_DOWNLOAD_HOST=https://artifactory.example.com/artifactory/playwright-cdn
# PLAYWRIGHT_DOWNLOAD_HOST=

# CI/CD variable of the manual `audit` job: when set, the audit also runs lint, typecheck, test and security (slow).
# Read from: the real environment only (a GitLab CI/CD variable, set on the pipeline when you start it)
# Values: any non-empty value turns it on
# Default: unset | Required: no | Secret: no
# Example: AUDIT_RUN_GATES=1
# AUDIT_RUN_GATES=
