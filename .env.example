# Copy to .env.<yourenv>.local for secrets that must never be committed
# (real API keys/tokens). This repo's own test suite (tests/apiClient.spec.ts)
# talks to an in-process mock server and does NOT read these - they're the
# template every real consuming project follows for its own API_BASE_URL.

LOG_LEVEL=info
API_BASE_URL=https://api.qa.example.com
API_KEY=replace-me
