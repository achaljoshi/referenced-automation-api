{
  "name": "@automation/referenced-automation-api",
  "version": "1.0.0",
  "description": "Reusable Playwright-based API testing framework: every HTTP method, header/body CRUD (JSON/XML/form/multipart), query/path params, auth strategies, pagination, a response wrapper that traverses like response.get('data[0].name'), and three API mocking tools (MockServer, mockApiRoute, record/replay).",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rimraf dist *.tgz",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "playwright test",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "security": "automation-audit-gate && automation-scan-secrets"
  },
  "dependencies": {
    "@automation/referenced-automation-utils": "file:../shared-packages/automation-referenced-automation-utils-1.0.0.tgz",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.62.1 <2.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.9",
    "eslint": "^8.57.1",
    "multer": "^2.0.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  }
}
