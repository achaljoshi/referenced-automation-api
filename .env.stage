# Committed settings for ENV=stage (no secrets: those go in .env.stage.local, template .env.local.example). Every key: .env.example.
# The ENV line below only repeats the name: the real ENV variable chooses this file, so changing it here has no effect.
# LOG_LEVEL is read from the real environment only (logger), so the line below has no effect either: use $env:LOG_LEVEL / LOG_LEVEL=... in the shell.
ENV=stage
LOG_LEVEL=debug
API_BASE_URL=https://api.stage.example.com
